{
  "name": "vexplor-edge",
  "version": "1.2.0",
  "description": "VEXPLOR Edge — the remote collector. Reads the PLCs an approved read list names and sends signed batches out over HTTPS (contract vexplor.edge/1)",
  "license": "Apache-2.0",
  "author": "WACE",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/waceinc/vexplor-edge",
  "repository": {
    "type": "git",
    "url": "https://github.com/waceinc/vexplor-edge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vexplor-edge": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:interop": "vitest run --config vitest.interop.config.ts",
    "pack:release": "npm run build && node scripts/pack.mjs --arm64 --windows"
  },
  "dependencies": {
    "@aas/collector": "https://github.com/waceinc/vexplor-aas/releases/download/v2.11.0/aas-collector-2.11.0.tgz",
    "@aas/core": "https://github.com/waceinc/vexplor-aas/releases/download/v2.11.0/aas-core-2.11.0.tgz",
    "@aas/fieldbus": "https://github.com/waceinc/vexplor-aas/releases/download/v2.11.0/aas-fieldbus-2.11.0.tgz",
    "@aas/opcua": "https://github.com/waceinc/vexplor-aas/releases/download/v2.11.0/aas-opcua-2.11.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "fflate": "^0.8.3",
    "postject": "1.0.0-alpha.6",
    "rolldown": "1.2.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "node-opcua": "2.178.0"
  }
}
